# Copier ce fichier en `.env` et adapter les valeurs. Ne jamais versionner `.env`.

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Base de données -----------------------------------------------------------
DATABASE_URL=postgres://afridev:afridev@localhost:5434/afridev
POSTGRES_DB=afridev
POSTGRES_USER=afridev
POSTGRES_PASSWORD=afridev
POSTGRES_HOST_PORT=5434

# --- Frontend, CORS et CSRF ----------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Authentification JWT ------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_COOKIE_NAME=afridev_refresh
AUTH_COOKIE_SECURE=False
# Lax si le frontend et l'API partagent le même site ; None (avec Secure) sinon.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

# --- Sécurité (production) -----------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_COOKIE_SECURE=True

# --- E-mail ---------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AfriDev Community <no-reply@afridev.local>

# --- Fichiers -------------------------------------------------------------------
DJANGO_SERVE_MEDIA=True
MAX_IMAGE_UPLOAD_BYTES=2097152

# --- API ------------------------------------------------------------------------
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
THROTTLE_ANON=120/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_TOKEN_REFRESH=60/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour

# --- Conteneur ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Adresse de l'API vue par le navigateur, figée dans l'image du frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
SEED_REFERENCE=1
SEED_DEMO=0

# --- Mise en ligne (docker-compose.prod.yml, voir docs/deploiement.md) ----------
# Nom de domaine public du site, sans https://
DOMAIN=
# Base PostgreSQL gérée externe (facultatif) : remplace la base du service db.
PROD_DATABASE_URL=
